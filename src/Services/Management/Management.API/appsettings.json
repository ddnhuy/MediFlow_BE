{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GrpcSettings": {
    "HumanResourceUrl": "https://humanresource.grpc:8081",
    "InventoryUrl": "https://inventory.api:8081",
    "VaccinationReceptionUrl": "https://vaccinationreception.api:8081"
  },
  "Jwt": {
