{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=Postgres;Port=5432;Database=VaccinationReceptionDb;User Id=postgres;Password=postgres;Include Error Detail=true;Pooling=true;MinPoolSize=5;MaxPoolSize=100;CommandTimeout=30;"
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "MediFlowIssuer",
    "Audience": "MediFlowAudience",
    "ExpirationInMinutes": 60
  },
  "GrpcSettings": {
    "CustomerInfoUrl": "https://customerinfo.grpc:8081",
    "HumanResourceUrl": "https://humanresource.grpc:8081"
  },
  "HospitalService": {
    "BaseUrl": "https://hospitalservice.api:8081"
  },
  "InventoryService": {
    "BaseUrl": "http://inventory.api:8080"
  },
  "MessageBroker": {
    "Host": "amqp://mediflow-mq:5672",
    "UserName": "mediflow",
    "Password": "Mediflow@123"
  },
  "QuartzJobs": {
    "CleanupUnpaidItemsJob": {
      "Cron": "0 30 23 * * ?",
      "JobKey": "CleanupUnpaidItemsJob",
      "Trigger": "CleanupUnpaidItemsJob-trigger"
    }
  }
}