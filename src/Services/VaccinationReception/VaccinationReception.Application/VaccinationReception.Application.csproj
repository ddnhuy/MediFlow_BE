	<ItemGroup>
		<Protobuf Include="..\..\CustomerInfo\CustomerInfo.Grpc\Protos\patient.proto" AdditionalImportDirs="..\..\CustomerInfo\CustomerInfo.Grpc" GrpcServices="Client">
