{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "Redis:6379,password=Mediflow@123,allowAdmin=true"
  },
  "GrpcSettings": {
    "HumanResourceUrl": "https://humanresource.grpc:8081"
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "MediFlowIssuer",
    "Audience": "MediFlowAudience",
    "ExpirationInMinutes": 60
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "SegmentsPerWindow": 4,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "Routes": {
      "authentication-route": {
        "ClusterId": "authentication-cluster",
        "Match": {
          "Path": "/authentication/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "management-route": {
        "ClusterId": "management-cluster",
        "Match": {
          "Path": "/management/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "vaccination-reception-route": {
        "ClusterId": "vaccination-reception-cluster",
        "Match": {
          "Path": "/vaccination-reception/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "file-storage-route": {
        "ClusterId": "file-storage-cluster",
        "Match": {
          "Path": "/file-storage/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "authentication-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://authentication.api:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://inventory.api:8080"
          }
        }
      },
      "management-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://management.api:8080"
          }
        }
      },
      "vaccination-reception-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://vaccinationreception.api:8080"
          }
        }
      },
      "file-storage-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://filestorage.api:8080"
          }
        }
      },
      "appointment-cluster": {
        "Destinations": {
          "default": {
            "Address": "http://appointment.api:8080"
          }
        }
      }
    }
  }
}